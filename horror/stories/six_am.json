    {"line": "At six, the kitchen light flicks on.", "scene": "cctv", "cam": "wide", "react": "lights_on", "beat_word": "flicks", "room": "kitchen", "other": {"state": "back"}, "text": {"label": "CAM 01", "time": "THU 06:00"}},
